{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "edwc_projects.schema.json",
  "title": "Curated data-center projects in the EDWC clusters",
  "description": "Project-level inventory compiled by hand from press and government announcements. Investment figures are PLANNED amounts as announced (亿元), not audited spending; coordinates are present only where the compiler recorded them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "projects"
  ],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "file",
        "sheet",
        "compiled",
        "licence_note"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sheet": {
          "type": "string",
          "minLength": 1
        },
        "compiled": {
          "description": "Date of the spreadsheet version the records were taken from (YYYY-MM-DD).",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "converted": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "licence_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cluster_id",
          "record_type",
          "name_zh",
          "name_en",
          "company",
          "investment_planned_100m_cny",
          "coordinates",
          "location_precision",
          "source_url",
          "flags",
          "verified",
          "placeholder"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_]*$",
            "maxLength": 80
          },
          "cluster_id": {
            "description": "id of the primary cluster feature in edwc_hubs.geojson.",
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_]*$"
          },
          "site_id": {
            "description": "id of a secondary site feature (part_of the cluster) when the project belongs to it; otherwise null.",
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z0-9][a-z0-9_]*$"
          },
          "record_type": {
            "description": "project = one facility or campus; park = an aggregate row for a whole industrial park or cluster (excluded from project counts and sums).",
            "enum": [
              "project",
              "park"
            ]
          },
          "name_zh": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "name_en": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "city_zh": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 60
          },
          "sub_area_zh": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 60
          },
          "company": {
            "description": "Developer / operator as written in the source sheet.",
            "type": [
              "string",
              "null"
            ],
            "maxLength": 120
          },
          "company_group": {
            "description": "Normalised operator group for filtering and charts.",
            "enum": [
              "china_telecom",
              "china_mobile",
              "china_unicom",
              "china_broadnet",
              "huawei",
              "alibaba",
              "tencent",
              "gcbd_apple",
              "chindata",
              "vnet",
              "ucloud",
              "kingsoft",
              "bank_finance",
              "state_owned_other",
              "other",
              "unknown"
            ]
          },
          "investment_planned_100m_cny": {
            "description": "Announced planned investment in 亿元 (hundred million yuan). null when the sheet has no numeric figure.",
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "investment_text": {
            "description": "Raw investment wording when it could not be parsed into a number.",
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          },
          "area_investment_100m_cny": {
            "description": "For park rows: announced investment for the whole area, in 亿元.",
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "date_opened": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "date_text": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "investment_sources_text": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "coordinates": {
            "description": "GeoJSON order [longitude, latitude], or null when the sheet records no position.",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "location_precision": {
            "enum": [
              "point",
              "area",
              "city",
              null
            ]
          },
          "source_url": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https?://"
          },
          "flags": {
            "description": "Data-quality flags raised during conversion, so nothing is silently cleaned.",
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "no_name_zh",
                "no_source",
                "shared_centroid",
                "company_mismatch",
                "outside_start_zone",
                "unparsed_investment",
                "duplicate_name_suspected",
                "truncated_name",
                "repeated_name_text"
              ]
            }
          },
          "verified": {
            "description": "True only once the record has been re-checked against its source_url.",
            "type": "boolean"
          },
          "placeholder": {
            "type": "boolean"
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 600
          },
          "sheet_row": {
            "description": "1-based row number in the source sheet, for traceability.",
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
