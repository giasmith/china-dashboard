{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/china-dashboard/power_lines.schema.json",
  "title": "Transmission lines (OpenStreetMap, ODbL) projected to the map view box, by province and voltage class",
  "type": "object",
  "required": ["generated", "min_kv", "source", "classes", "paths", "km_by_province", "dropped"],
  "additionalProperties": false,
  "$defs": {
    "classKey": { "enum": ["220", "330", "500", "750", "uhv"] }
  },
  "properties": {
    "generated": { "type": "string", "format": "date" },
    "min_kv": { "type": "number", "minimum": 200, "maximum": 1000 },
    "source": {
      "type": "object",
      "required": ["title", "publisher", "licence", "url", "tier"],
      "properties": { "tier": { "enum": ["A", "B", "C"] } }
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "label", "min_kv", "max_kv", "ways", "km"],
        "additionalProperties": false,
        "properties": {
          "key": { "$ref": "#/$defs/classKey" },
          "label": { "type": "string", "minLength": 1 },
          "min_kv": { "type": "number", "minimum": 0 },
          "max_kv": { "type": ["number", "null"] },
          "ways": { "type": "integer", "minimum": 1 },
          "km": { "type": "number", "minimum": 0 }
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "$ref": "#/$defs/classKey" },
        "additionalProperties": { "type": "string", "pattern": "^M[-0-9., M]+$" }
      }
    },
    "km_by_province": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "$ref": "#/$defs/classKey" },
        "additionalProperties": { "type": "number", "minimum": 0 }
      }
    },
    "dropped": { "type": "object" }
  }
}
